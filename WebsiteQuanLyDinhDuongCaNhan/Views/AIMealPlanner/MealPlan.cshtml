@{
    ViewBag.Title = "7-Day Meal Plan";
    ViewData["HideFooter"] = true;
}

@using Newtonsoft.Json.Linq
@using System.Web @* Dùng cho HttpUtility nếu cần *@

<div class="meal-plan-wrapper container pb-5" style="padding-top: 120px;">

    <div class="header-content text-center mb-5">
        <h1 class="class="fw-bold text-gold mb-2 main-title" style="font-family: 'Montserrat', sans-serif !important; font-weight: 900 !important; letter-spacing: 5px; color: #C4A46B !important; text-transform: uppercase;font-size: 50px">7-DAY MEAL PLAN</h1>
        <div class="tdee-badge mb-3 d-flex justify-content-center align-items-center gap-3 flex-wrap">
            @* Badge TDEE *@
            <span class="badge rounded-pill bg-gold-light px-3 py-2 border-gold-thin" style="color: #000 !important; border-radius: 20px; border-color: black;">
                <i class="fas fa-fire me-1 text-gold"></i>
                <small>Your TDEE:</small> <strong>@ViewBag.TDEE</strong> <small>kcal/day</small>
            </span>

            @* Nút Refresh Plan *@
            <a href="@Url.Action("GenerateNewPlan", "AIMealPlanner")" class="btn btn-refresh-solid">
                <i class="fas fa-sync-alt me-1"></i> Refresh Plan
            </a>
        </div>
        @* Đã sửa màu chữ slogan ở đây thành màu vàng đậm sang trọng *@
        <p class="slogan-text italic" style="color: #8a6d3b; font-size: 1.05rem;">
            "A journey to health starts with a single meal plan"
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning mx-auto text-center mb-4 shadow-sm" style="max-width: 600px; border-radius: 50px;">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.WeeklyMealPlan != null)
    {
        try
        {
            var weeklyData = JObject.Parse(ViewBag.WeeklyMealPlan);
            var week = weeklyData["week"];

            if (week != null)
            {
                var days = new[] { "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" };
                var dayLabels = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

                <div class="selector-card mx-auto mb-5 shadow-sm">
                    <div class="px-3 py-1 d-flex align-items-center justify-content-center">
                        <label for="daySelect" class="me-2 mb-0 small fw-bold text-muted text-uppercase" style="font-size: 0.65rem;">Select Day:</label>
                        <select id="daySelect" class="form-select custom-select" onchange="showDayMeals(this.value)">
                            @for (int i = 0; i < days.Length; i++)
                            {
                                <option value="@i">Day @(i + 1) - @dayLabels[i]</option>
                            }
                        </select>
                    </div>
                </div>

                for (int dayIndex = 0; dayIndex < days.Length; dayIndex++)
                {
                    var dayName = days[dayIndex];
                    var dayData = week[dayName];

                    if (dayData != null)
                    {
                        var meals = dayData["meals"];
                        var nutrients = dayData["nutrients"];
                        double totalDayCals = (double)(nutrients?["calories"] ?? 0);

                        <div id="day-@dayIndex" class="day-container animate-fade-in" style="display: @(dayIndex == 0 ? "block" : "none")">

                            <div class="nutrition-summary-box mx-auto mb-5" style="max-width: 850px;">
                                @if (nutrients != null)
                                {
                                    <div class="main-cal-strip shadow-sm mb-4">
                                        <span class="label d-block small opacity-75">TOTAL DAILY ENERGY</span>
                                        <div class="d-flex align-items-baseline justify-content-center">
                                            <strong class="value">@((int)totalDayCals)</strong>
                                            <span class="unit ms-2">kcal</span>
                                        </div>
                                    </div>

                                    <div class="sub-nutrients-row d-flex justify-content-center gap-3">
                                        <div class="sub-nutri-item shadow-sm">
                                            <span class="sub-value">@((int)(nutrients["protein"] ?? 0))g</span>
                                            <span class="sub-label">Protein</span>
                                        </div>

                                        <div class="sub-nutri-item shadow-sm">
                                            <span class="sub-value">@((int)(nutrients["fat"] ?? 0))g</span>
                                            <span class="sub-label">Fat</span>
                                        </div>

                                        <div class="sub-nutri-item shadow-sm">
                                            <span class="sub-value">@((int)(nutrients["carbohydrates"] ?? 0))g</span>
                                            <span class="sub-label">Carbs</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="row justify-content-center">
                                @{ int mealIndex = 0; }
                                @foreach (var meal in meals)
                                {
                                    var mealId = meal["id"]?.ToString() ?? "";
                                    var title = meal["title"]?.ToString() ?? "Untitled Recipe";
                                    var readyInMinutes = meal["readyInMinutes"]?.ToString() ?? "--";
                                    var servings = meal["servings"]?.ToString() ?? "1";

                                    double mealCals = 0;
                                    if (meal["calories"] != null && (double)meal["calories"] > 0)
                                    {
                                        mealCals = (double)meal["calories"];
                                    }
                                    else
                                    {
                                        double ratio = mealIndex == 0 ? 0.25 : (mealIndex == 1 ? 0.40 : 0.35);
                                        mealCals = totalDayCals * ratio;
                                    }

                                    var imageRaw = meal["image"]?.ToString() ?? "";
                                    var imageUrl = string.IsNullOrEmpty(imageRaw) ? "/images/default-meal.jpg" :
                                                   (imageRaw.StartsWith("http") ? imageRaw : $"https://spoonacular.com/recipeImages/{imageRaw}");

                                    <div class="col-lg-9 mb-5 d-flex flex-column align-items-center">
                                        <div class="meal-type-label">
                                            <span>@(mealIndex == 0 ? "BREAKFAST" : (mealIndex == 1 ? "LUNCH" : "DINNER"))</span>
                                        </div>

                                        <div class="meal-card-horizontal w-100">
                                            <div class="meal-card-img">
                                                <img src="@imageUrl" alt="@title" class="zoom-img" loading="lazy" />

                                                <button class="btn-favorite-heart" onclick="toggleFavorite(this, '@mealId')" title="Add to favorites">
                                                    <i class="far fa-heart"></i>
                                                </button>

                                                <div class="meal-cal-badge">
                                                    <i class="fas fa-fire me-1 text-warning"></i>
                                                    <strong>@((int)Math.Round(mealCals))</strong> <small>kcal</small>
                                                </div>
                                            </div>
                                            <div class="meal-card-content">
                                                <h3 class="meal-title">@title</h3>
                                                <div class="meal-meta d-flex gap-3 mb-3">
                                                    <span><i class="far fa-clock me-1 text-gold"></i> @readyInMinutes min</span>
                                                    <span><i class="fas fa-utensils me-1 text-gold"></i> @servings serving@(int.Parse(servings) > 1 ? "s" : "")</span>
                                                </div>
                                                <div class="meal-actions mt-auto">
                                                    <a href="@Url.Action("RecipeDetail", "AIMealPlanner", new { recipeId = mealId })" class="btn btn-main">
                                                        View Recipe <i class="fas fa-chevron-right ms-1" style="font-size: 0.7rem;"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    mealIndex++;
                                }
                            </div>
                        </div>
                    }
                }
            }
        }
        catch (Exception ex)
        {
            <div class="alert alert-danger text-center">Error processing data: @ex.Message</div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <div class="empty-state-icon mb-3">
                <i class="fas fa-utensils fa-3x text-muted opacity-25"></i>
            </div>
            <p class="text-muted">No meal plan found. Click "Refresh Plan" to generate one.</p>
        </div>
    }
</div>

