<script>
    // Hàm chuyển đổi ngày hiển thị
    function showDayMeals(dayIndex) {
        const containers = document.querySelectorAll('.day-container');
        containers.forEach(el => {
            el.style.display = 'none';
            el.classList.remove('animate-fade-in');
        });

        const activeDay = document.getElementById('day-' + dayIndex);
        if (activeDay) {
            activeDay.style.display = 'block';
            void activeDay.offsetWidth;
            activeDay.classList.add('animate-fade-in');
        }
        window.scrollTo({ top: document.querySelector('.selector-card').offsetTop - 120, behavior: 'smooth' });
    }

    // --- SỬA LỖI NÚT TIM TẠI ĐÂY ---
    // --- ĐÃ CẬP NHẬT ĐỂ CHỌN CATEGORY ---
    function toggleFavorite(btn, recipeId) {
        const card = btn.closest('.meal-card-horizontal');
        const title = card.querySelector('.meal-title').innerText;
        const image = card.querySelector('.zoom-img').src;
        const icon = btn.querySelector('i');

        if (btn.classList.contains('active')) {
            $.post("/AIMealPlanner/ToggleFavorite", { recipeId: recipeId }, function (data) {
                if (data.success) {
                    btn.classList.remove('active');
                    icon.classList.replace('fas', 'far');
                }
            });
            return;
        }

        Swal.fire({
            title: 'Food classification',
            html: '<p style="font-size: 0.9rem; color: #666; margin-top: 5px;">Choose a label to save to your collection</p>',
            input: 'select',
            inputOptions: {
                'healthy': '#Healthy',
                'quick': '#QuickMeal',
                'dinner': '#Dinner'
            },
            inputPlaceholder: '-- Choose a label --',
            showCancelButton: true,
            confirmButtonText: 'Save',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#C4A46B', // Màu Gold trực tiếp cho nút
            cancelButtonColor: '#6c757d',
            padding: '1.5rem', // Tạo khoảng trống sang trọng
            background: '#fdfbf7',
            customClass: {
                popup: 'swal-gold-popup',
                title: 'swal-gold-title',
                input: 'swal-gold-input',
                confirmButton: 'swal-gold-button'
            }
        }).then((result) => {
            if (result.isConfirmed && result.value) {
                const selectedCategory = result.value;

                $.post("/AIMealPlanner/ToggleFavorite", {
                    recipeId: recipeId,
                    title: title,
                    image: image,
                    category: selectedCategory
                }, function (data) {
                    if (data.success) {
                        btn.classList.add('active');
                        icon.classList.replace('far', 'fas');

                        // Thông báo Toast thành công đơn giản màu Gold
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            title: `Saved #${selectedCategory}`,
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true,
                            background: '#C4A46B', // Màu nền Gold
                            color: '#fff',         // Chữ trắng
                            iconColor: '#fff'      // Icon trắng
                        });
                    }
                });
            }
        });
    }
    // Hiệu ứng nút Refresh
    document.getElementById('frmRefresh').addEventListener('submit', function (e) {
        if (!confirm('Tạo thực đơn mới? Thực đơn hiện tại sẽ bị thay thế.')) {
            e.preventDefault();
            return false;
        }
        const btn = this.querySelector('#btnRefresh');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang tạo thực đơn...';
        btn.classList.add('disabled', 'opacity-75');
        btn.disabled = true;
    });
</script>