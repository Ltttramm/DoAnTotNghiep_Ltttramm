@*@{
        ViewBag.Title = "7-Day Meal Plan";
        ViewData["HideFooter"] = true;
    }

    <div class="meal-plan-wrapper container pb-5" style="padding-top: 180px;">

        <div class="header-content text-center mb-4">
            <h1 class="fw-bold text-[#C4A46B] mb-2 main-title">7-DAY MEAL PLAN</h1>

            <div class="tdee-badge mb-2 d-flex justify-content-center">
                <span class="badge rounded-pill bg-gold-light px-3 py-2">
                    <i class="fas fa-fire me-1"></i><small>Your TDEE:</small> <strong>@ViewBag.TDEE</strong> <small>kcal/day</small>
                </span>
            </div>

            <p class="slogan-text">"A journey to health starts with a single meal plan"</p>
        </div>

        @if (ViewBag.WeeklyMealPlan != null)
        {
            try
            {
                var weeklyData = Newtonsoft.Json.Linq.JObject.Parse(ViewBag.WeeklyMealPlan);
                var week = weeklyData["week"];

                if (week != null)
                {
                    var days = new[] { "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" };
                    var dayLabels = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

                    <div class="selector-card mx-auto mb-5 shadow-sm">
                        <div class="px-3 py-1 d-flex align-items-center justify-content-center">
                            <label for="daySelect" class="me-2 mb-0 small fw-bold text-muted text-uppercase" style="font-size: 0.65rem;">Select:</label>
                            <select id="daySelect" class="form-select custom-select" onchange="showDayMeals(this.value)">
                                @for (int i = 0; i < days.Length; i++)
                                {
                                    <option value="@i">Day @(i + 1) - @dayLabels[i]</option>
                                }
                            </select>
                        </div>
                    </div>

                    for (int dayIndex = 0; dayIndex < days.Length; dayIndex++)
                    {
                        var dayName = days[dayIndex];
                        var dayData = week[dayName];

                        if (dayData != null)
                        {
                            var meals = dayData["meals"];
                            var nutrients = dayData["nutrients"];

                            <div id="day-@dayIndex" class="day-container animate-fade-in" style="display: @(dayIndex == 0 ? "block" : "none")">

                                <div class="nutrition-summary-box mx-auto mb-5" style="max-width: 850px;">
                                    @if (nutrients != null)
                                    {
                                        <div class="main-cal-strip shadow-sm mb-3">
                                            <span class="label">TOTAL DAILY ENERGY</span>
                                            <div class="d-flex align-items-baseline justify-content-center">
                                                <strong class="value">@((int)double.Parse(nutrients["calories"]?.ToString() ?? "0"))</strong>
                                                <span class="unit ms-1">kcal</span>
                                            </div>
                                        </div>

                                        <div class="sub-nutrients-row d-flex justify-content-center gap-3">
                                            <div class="sub-nutri-item shadow-sm">
                                                <span class="sub-value">@((int)double.Parse(nutrients["protein"]?.ToString() ?? "0"))g</span>
                                                <span class="sub-label">Protein</span>
                                            </div>
                                            <div class="sub-nutri-item shadow-sm">
                                                <span class="sub-value">@((int)double.Parse(nutrients["fat"]?.ToString() ?? "0"))g</span>
                                                <span class="sub-label">Fat</span>
                                            </div>
                                            <div class="sub-nutri-item shadow-sm">
                                                <span class="sub-value">@((int)double.Parse(nutrients["carbohydrates"]?.ToString() ?? "0"))g</span>
                                                <span class="sub-label">Carbs</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="row justify-content-center">
                                    @{ int mealIndex = 0; }
                                    @foreach (var meal in meals)
                                    {
                                        var mealId = meal["id"]?.ToString() ?? "";
                                        var title = meal["title"]?.ToString() ?? "Unknown";
                                        var readyInMinutes = meal["readyInMinutes"]?.ToString() ?? "N/A";
                                        var servings = meal["servings"]?.ToString() ?? "1";
                                        // Lấy calo của riêng món ăn này
                                        var mealCalories = meal["calories"]?.ToString() ?? "0";
                                        var imageRaw = meal["image"]?.ToString() ?? "";
                                        var imageUrl = string.IsNullOrEmpty(imageRaw) ? "/images/default.jpg" :
                                                       (imageRaw.StartsWith("http") ? imageRaw : $"https://spoonacular.com/recipeImages/{imageRaw}");

                                        <div class="col-lg-10 mb-4 d-flex flex-column align-items-center">
                                            <div class="meal-type-label">
                                                <span>@(mealIndex == 0 ? "BREAKFAST" : (mealIndex == 1 ? "LUNCH" : "DINNER"))</span>
                                            </div>

                                            <div class="meal-card-horizontal w-100">
                                                <div class="meal-card-img">
                                                    <img src="@imageUrl" alt="@title" class="zoom-img" />
                                                    <div class="meal-cal-badge">
                                                        <strong>@((int)double.Parse(mealCalories))</strong> kcal
                                                    </div>
                                                </div>
                                                <div class="meal-card-content">
                                                    <h3 class="meal-title">@title</h3>
                                                    <div class="meal-meta d-flex gap-3">
                                                        <span><i class="far fa-clock me-1 text-gold"></i> @readyInMinutes mins</span>
                                                        <span><i class="fas fa-utensils me-1 text-gold"></i> @servings servings</span>
                                                    </div>
                                                    <div class="meal-actions mt-auto">
                                                        <a href="@Url.Action("RecipeDetail", "AIMealPlanner", new { recipeId = mealId })" class="btn btn-main">View Recipe</a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        mealIndex++;
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            }
            catch (Exception)
            {
                <div class="alert alert-danger text-center">Error loading meal plan.</div>
            }
        }
    </div>

    <style>
        :root {
            --main-gold: #C4A46B;
            --soft-bg: #fdfbf7;
            --dark-text: #333;
            --gold-hover: #ac8e56;
        }

        body {
            font-size: 0.85rem;
            background-color: var(--soft-bg);
            color: var(--dark-text);
        }

        .main-title {
            font-size: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .slogan-text {
            font-size: 0.9rem;
            opacity: 0.7;
            font-style: italic;
            color: black;
        }

        /* Day Selector */
        .selector-card {
            max-width: 260px;
            background: white;
            border-radius: 10px;
            border: 1px solid var(--main-gold);
        }

        .custom-select {
            border: none !important;
            box-shadow: none !important;
            font-weight: 600;
            color: var(--main-gold);
            font-size: 0.85rem;
            padding: 0.1rem 0.5rem;
            width: auto;
            cursor: pointer;
        }

        /* Nutrition Box */
        .main-cal-strip {
            background: var(--main-gold);
            color: white;
            padding: 12px;
            border-radius: 12px;
            text-align: center;
        }

            .main-cal-strip .label {
                font-size: 0.6rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                display: block;
                margin-bottom: 2px;
            }

            .main-cal-strip .value {
                font-size: 2.2rem;
                line-height: 1;
            }

        .sub-nutri-item {
            background: white;
            flex: 1;
            padding: 8px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid #eee;
        }

            .sub-nutri-item .sub-value {
                display: block;
                font-size: 1rem;
                font-weight: 700;
            }

            .sub-nutri-item .sub-label {
                font-size: 0.6rem;
                text-transform: uppercase;
                color: #999;
            }

        /* Meal Card Horizontal */
        .meal-card-horizontal {
            display: flex;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            height: 180px; /* Thu nhỏ thêm một chút cho cân đối */
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
        }

        .meal-card-img {
            flex: 0 0 32%;
            overflow: hidden;
            position: relative;
        }

        .zoom-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.6s ease;
        }

        .meal-card-horizontal:hover .zoom-img {
            transform: scale(1.08);
        }

        /* Calo Badge trên ảnh */
        .meal-cal-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(255, 255, 255, 0.9);
            color: var(--dark-text);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            border: 1px solid var(--main-gold);
            z-index: 2;
        }

            .meal-cal-badge strong {
                color: var(--main-gold);
            }

        .meal-card-content {
            flex: 1;
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
        }

        .meal-title {
            font-size: 1.05rem;
            font-weight: 700;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 8px;
        }

        .meal-meta {
            font-size: 0.8rem;
            color: #666;
            margin-bottom: 10px;
        }

        .text-gold {
            color: var(--main-gold);
        }

        .meal-type-label {
            margin-bottom: -10px;
            z-index: 5;
        }

            .meal-type-label span {
                background: var(--main-gold);
                color: white;
                padding: 3px 12px;
                border-radius: 50px;
                font-weight: bold;
                font-size: 0.65rem;
                text-transform: uppercase;
            }

        .btn-main {
            background-color: var(--main-gold);
            color: white;
            border-radius: 50px;
            padding: 5px 18px;
            font-weight: bold;
            font-size: 0.8rem;
            text-decoration: none;
            align-self: flex-start;
        }

            .btn-main:hover {
                background-color: var(--gold-hover);
                color: white;
                transform: translateY(-1px);
            }

        .bg-gold-light {
            background-color: rgba(196, 164, 107, 0.1);
            color: var(--main-gold);
            border: 1px solid var(--main-gold);
        }

        .animate-fade-in {
            animation: fadeIn 0.4s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .meal-card-horizontal {
                height: auto;
                flex-direction: column;
            }

            .meal-card-img {
                height: 150px;
            }

            .meal-card-content {
                padding: 15px;
            }
        }
    </style>

    <script>
        function showDayMeals(dayIndex) {
            document.querySelectorAll('.day-container').forEach(el => el.style.display = 'none');
            document.getElementById('day-' + dayIndex).style.display = 'block';
            const headerPos = document.querySelector('.header-content').offsetTop - 100;
            window.scrollTo({ top: headerPos, behavior: 'smooth' });
        }
    </script>*@

@*@{
        ViewBag.Title = "7-Day Meal Plan";
        ViewData["HideFooter"] = true;
    }

    @using Newtonsoft.Json.Linq

    <div class="meal-plan-wrapper container pb-5" style="padding-top: 150px;">

        <div class="header-content text-center mb-4">
            <h1 class="fw-bold text-gold mb-2 main-title">7-DAY MEAL PLAN</h1>

            <div class="tdee-badge mb-3 d-flex justify-content-center align-items-center gap-2 flex-wrap">
                <span class="badge rounded-pill bg-gold-light px-3 py-2 text-dark border">
                    <i class="fas fa-fire me-1 text-gold"></i>
                    <small>Your TDEE:</small> <strong>@ViewBag.TDEE</strong> <small>kcal/day</small>
                </span>

                <a href="@Url.Action("GenerateNewPlan", "AIMealPlanner")"
                   class="btn btn-refresh shadow-sm"
                   id="btnRefresh">
                    <i class="fas fa-sync-alt me-1"></i> Refresh Plan
                </a>
            </div>

            <p class="slogan-text text-muted">"A journey to health starts with a single meal plan"</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-warning mx-auto text-center mb-4 shadow-sm" style="max-width: 600px; border-radius: 50px;">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            </div>
        }

        @if (ViewBag.WeeklyMealPlan != null)
        {
            try
            {
                var weeklyData = JObject.Parse(ViewBag.WeeklyMealPlan);
                var week = weeklyData["week"];

                if (week != null)
                {
                    var days = new[] { "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday" };
                    var dayLabels = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

                    <div class="selector-card mx-auto mb-5 shadow-sm">
                        <div class="px-3 py-1 d-flex align-items-center justify-content-center">
                            <label for="daySelect" class="me-2 mb-0 small fw-bold text-muted text-uppercase" style="font-size: 0.65rem;">Select Day:</label>
                            <select id="daySelect" class="form-select custom-select" onchange="showDayMeals(this.value)">
                                @for (int i = 0; i < days.Length; i++)
                                {
                                    <option value="@i">Day @(i + 1) - @dayLabels[i]</option>
                                }
                            </select>
                        </div>
                    </div>

                    for (int dayIndex = 0; dayIndex < days.Length; dayIndex++)
                    {
                        var dayName = days[dayIndex];
                        var dayData = week[dayName];

                        if (dayData != null)
                        {
                            var meals = dayData["meals"];
                            var nutrients = dayData["nutrients"];
                            double totalDayCals = (double)(nutrients?["calories"] ?? 0);

                            <div id="day-@dayIndex" class="day-container animate-fade-in" style="display: @(dayIndex == 0 ? "block" : "none")">

                                <div class="nutrition-summary-box mx-auto mb-5" style="max-width: 850px;">
                                    @if (nutrients != null)
                                    {
                                        <div class="main-cal-strip shadow-sm mb-3">
                                            <span class="label d-block small opacity-75">TOTAL DAILY ENERGY</span>
                                            <div class="d-flex align-items-baseline justify-content-center">
                                                <strong class="value">@((int)totalDayCals)</strong>
                                                <span class="unit ms-1">kcal</span>
                                            </div>
                                        </div>

                                        <div class="sub-nutrients-row d-flex justify-content-center gap-2 gap-md-3">
                                            <div class="sub-nutri-item shadow-sm">
                                                <span class="sub-value">@((int)(nutrients["protein"] ?? 0))g</span>
                                                <span class="sub-label">Protein</span>
                                            </div>
                                            <div class="sub-nutri-item shadow-sm">
                                                <span class="sub-value">@((int)(nutrients["fat"] ?? 0))g</span>
                                                <span class="sub-label">Fat</span>
                                            </div>
                                            <div class="sub-nutri-item shadow-sm">
                                                <span class="sub-value">@((int)(nutrients["carbohydrates"] ?? 0))g</span>
                                                <span class="sub-label">Carbs</span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="row justify-content-center">
                                    @{ int mealIndex = 0; }
                                    @foreach (var meal in meals)
                                    {
                                        var mealId = meal["id"]?.ToString() ?? "";
                                        var title = meal["title"]?.ToString() ?? "Untitled Recipe";
                                        var readyInMinutes = meal["readyInMinutes"]?.ToString() ?? "--";
                                        var servings = meal["servings"]?.ToString() ?? "1";

                                        // LOGIC TÍNH CALO THEO TỶ LỆ ĐỂ TRÁNH HIỆN SỐ 0
                                        double mealCals = 0;
                                        if (meal["calories"] != null && (double)meal["calories"] > 0)
                                        {
                                            mealCals = (double)meal["calories"];
                                        }
                                        else
                                        {
                                            // Tỷ lệ gợi ý: Sáng 25%, Trưa 40%, Tối 35%
                                            double ratio = mealIndex == 0 ? 0.25 : (mealIndex == 1 ? 0.40 : 0.35);
                                            mealCals = totalDayCals * ratio;
                                        }

                                        var imageRaw = meal["image"]?.ToString() ?? "";
                                        var imageUrl = string.IsNullOrEmpty(imageRaw) ? "/images/default-meal.jpg" :
                                                       (imageRaw.StartsWith("http") ? imageRaw : $"https://spoonacular.com/recipeImages/{imageRaw}");

                                        <div class="col-lg-9 mb-4 d-flex flex-column align-items-center">
                                            <div class="meal-type-label">
                                                <span>@(mealIndex == 0 ? "BREAKFAST" : (mealIndex == 1 ? "LUNCH" : "DINNER"))</span>
                                            </div>

                                            <div class="meal-card-horizontal w-100">
                                                <div class="meal-card-img">
                                                    <img src="@imageUrl" alt="@title" class="zoom-img" loading="lazy" />
                                                    <div class="meal-cal-badge highlight-energy-mini">
                                                        <i class="fas fa-fire me-1 text-warning"></i>
                                                        <strong>@((int)Math.Round(mealCals))</strong> <small>kcal/serving</small>
                                                    </div>
                                                </div>
                                                <div class="meal-card-content">
                                                    <h3 class="meal-title text-truncate-2">@title</h3>
                                                    <div class="meal-meta d-flex gap-3 mb-3">
                                                        <span><i class="far fa-clock me-1 text-gold"></i> @readyInMinutes min</span>
                                                        <span><i class="fas fa-utensils me-1 text-gold"></i> @servings serving@(int.Parse(servings) > 1 ? "s" : "")</span>
                                                    </div>
                                                    <div class="meal-actions mt-auto">
                                                        <a href="@Url.Action("RecipeDetail", "AIMealPlanner", new { recipeId = mealId })" class="btn btn-main">
                                                            View Recipe <i class="fas fa-chevron-right ms-1" style="font-size: 0.7rem;"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        mealIndex++;
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                <div class="alert alert-danger text-center">Error processing data: @ex.Message</div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <div class="empty-state-icon mb-3">
                    <i class="fas fa-utensils fa-3x text-muted opacity-25"></i>
                </div>
                <p class="text-muted">No meal plan found. Click "Refresh Plan" to generate one.</p>
            </div>
        }
    </div>

