@{
    ViewBag.Title = "About Smart Meal";
}

<link rel="stylesheet" href="~/CSS/style.css" asp-append-version="true" />

<main class="about-page">

    <section class="about-hero">
        <div class="container">
            <div class="hero-content">
                <h1>About Smart Meal</h1>
                <p>Intelligent Nutrition Solutions for Modern Life</p>
            </div>
        </div>
    </section>

    <section class="about-intro container section-padding">
        <div class="about-grid">
            <div class="content-text">
                <h2 class="section-title">What is Smart Meal?</h2>
                <p>
                    Smart Meal is a digital platform designed to help users build a scientific,
                    balanced diet tailored to their unique physiological needs.
                    By leveraging advanced technology, we empower you to eat smarter,
                    save time, and achieve long-term health improvements.
                </p>
            </div>
            <div class="content-image">
                <img src="~/Image/eatclean2.jpg" alt="Healthy Lifestyle" class="img-responsive">
            </div>
        </div>
    </section>

    <section class="about-mission section-padding">
        <div class="container mission-grid">
            <div class="mission-item">
                <div class="mission-icon">🎯</div>
                <h3>Our Mission</h3>
                <p>To provide personalized nutritional solutions that make maintaining a healthy lifestyle easy and sustainable for everyone.</p>
            </div>

            <div class="mission-item">
                <div class="mission-icon">🚀</div>
                <h3>Our Vision</h3>
                <p>To become the leading smart nutrition platform, accompanying millions on their journey to wellness.</p>
            </div>

            <div class="mission-item">
                <div class="mission-icon">💎</div>
                <h3>Core Values</h3>
                <p>Science – Personalization – Convenience – Effectiveness are the pillars of everything we build.</p>
            </div>
        </div>
    </section>

    <section class="about-benefits container section-padding">
        <h2 class="section-title text-center">Why Choose Smart Meal?</h2>
        <div class="benefit-grid">
            <div class="benefit-item">
                <div class="benefit-icon-box">
                    <img src="~/Image/mũ.png" alt="Goal Icon">
                </div>
                <div class="benefit-content">
                    <h4>Personalized Plans</h4>
                    <p>Meal plans tailored to your specific health goals.</p>
                </div>
            </div>

            <div class="benefit-item">
                <div class="benefit-icon-box">
                    <img src="~/Image/mũ.png" alt="Analytics Icon">
                </div>
                <div class="benefit-content">
                    <h4>Precise Tracking</h4>
                    <p>Accurate monitoring of calories and macronutrients.</p>
                </div>
            </div>

            <div class="benefit-item">
                <div class="benefit-icon-box">
                    <img src="~/Image/mũ.png" alt="Time Icon">
                </div>
                <div class="benefit-content">
                    <h4>Smart Automation</h4>
                    <p>Automatic meal scheduling to save you time every day.</p>
                </div>
            </div>
        </div>
    </section>

    <footer class="about-cta">
        <div class="container">
            <h2>Start Your Healthy Journey Today</h2>
            <a href="@Url.Action("Index", "Home")" class="btn-cta">Back to Home</a>
        </div>
    </footer>

</main>
<style>
    /* --- Global Layout --- */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .section-padding {
        padding: 80px 0;
    }

    .text-center {
        text-align: center;
    }

    .section-title {
        font-size: 2.5rem;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    /* --- Hero Section --- */
    .about-hero {
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/Image/About.jfif');
        background-size: cover;
        background-position: center;
        height: 450px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        text-align: center;
    }

        .about-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .about-hero p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

    /* --- Intro Grid --- */
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .content-text p {
        line-height: 1.8;
        color: #555;
        font-size: 1.1rem;
    }

    .img-responsive {
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    /* --- Mission Grid --- */
    .about-mission {
        background-color: #f8fbf9;
    }

    .mission-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .mission-item {
        background: #ffffff;
        padding: 50px 30px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 10px 20px rgba(0,0,0,0.03);
        transition: all 0.3s ease;
    }

        .mission-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

    .mission-icon {
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .mission-item h3 {
        margin-bottom: 15px;
        color: #27ae60;
    }

    /* --- Benefits Grid --- */
    .benefit-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
        margin-top: 50px;
    }

    .benefit-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .benefit-icon-box {
        width: 80px;
        height: 80px;
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .benefit-item img {
        width: 70px;
        height: auto;
        filter: drop-shadow(0 5px 5px rgba(0,0,0,0.1));
    }

    .benefit-content h4 {
        margin-bottom: 10px;
        color: #333;
        font-weight: 700;
    }

    .benefit-content p {
        color: #666;
        line-height: 1.5;
    }

    /* --- Footer Section (Deep Forest Green - Elegant Tones) --- */
    .about-cta {
        background-color: #145a32; /* Xanh lục đậm, không chói, cực kỳ chuyên nghiệp */
        color: #ffffff;
        padding: 80px 0;
        text-align: center;
    }

        .about-cta h2 {
            font-size: 2.2rem;
            margin-bottom: 25px;
            font-weight: 600;
        }

    .btn-cta {
        display: inline-block;
        padding: 16px 45px;
        background-color: #ffffff;
        color: #145a32; /* Chữ tiệp màu với nền footer */
        text-decoration: none;
        border-radius: 50px;
        font-weight: 700;
        text-transform: uppercase;
        transition: 0.3s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

        .btn-cta:hover {
            background-color: #f1f1f1;
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }

    /* --- Responsive --- */
    @@media (max-width: 992px) {
        .about-grid, .mission-grid, .benefit-grid {
            grid-template-columns: 1fr;
        }

        .about-hero h1 {
            font-size: 2.5rem;
        }

        .benefit-item {
            margin-bottom: 30px;
        }
    }
</style>