@model IEnumerable<WebsiteQuanLyDinhDuongCaNhan.Models.Food>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Food Repository Management";
}

<style>
    /* Premium UI Styles */
    .table-container {
        background: #ffffff;
        border-radius: 15px;
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.05);
    }

    .table thead th {
        background-color: #f8f9fa;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #6c757d;
        border-top: none;
    }

    .food-img {
        transition: transform 0.2s;
        border: 1px solid #eee;
    }

        .food-img:hover {
            transform: scale(1.1);
        }

    .badge-source {
        font-weight: 500;
        padding: 0.4em 0.8em;
    }

    .btn-action {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .modal-content {
        border-radius: 20px;
        overflow: hidden;
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 0.6rem 1rem;
    }

    .calories-text {
        color: #e03131;
        font-weight: 700;
    }
</style>

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4 align-items-end">
        <div class="col-md-6">
            <h3 class="fw-bold text-dark m-0">Food Repository</h3>
            <p class="text-secondary mb-0">Manage internal inventory and API-sourced recipes</p>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-dark px-4 shadow-sm border-0" style="background-color: #D4AF37;" data-bs-toggle="modal" data-bs-target="#addFoodModal">
                <i class="bi bi-plus-lg me-2"></i>Add Local Food
            </button>
            <a href="@Url.Action("SearchApiFood", "Admin")" class="btn btn-outline-dark px-4 shadow-sm ms-2">
                <i class="bi bi-cloud-download me-2"></i>Browse API
            </a>
        </div>
    </div>

    <div class="table-container overflow-hidden border">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Image</th>
                        <th>Food Details</th>
                        <th>Calories</th>
                        <th>Visibility</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.FoodID">
                            <td class="ps-4">
                                <img src="@(string.IsNullOrEmpty(item.ImageURL) ? "https://placehold.co/60x60?text=No+Img" : item.ImageURL)"
                                     class="rounded-3 shadow-sm food-img" width="50" height="50" style="object-fit: cover;"
                                     onerror="this.src='https://placehold.co/60x60?text=Error'">
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.FoodName</div>
                                @if (string.IsNullOrEmpty(item.ExternalApiID))
                                {
                                    <span class="badge badge-source bg-info-subtle text-info border border-info-subtle">Local Item</span>
                                }
                                else
                                {
                                    <span class="badge badge-source bg-warning-subtle text-dark border border-warning-subtle">Spoonacular API</span>
                                }
                            </td>
                            <td>
                                <span class="calories-text">@item.Calories</span>
                                <span class="text-muted small">kcal</span>
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="switch-@item.FoodID"
                                           @(item.IsVisible != false ? "checked" : "")
                                           onclick="toggleFoodVisibility(@item.FoodID)">
                                </div>
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("EditFood", "Admin", new { id = item.FoodID })" class="btn btn-action btn-outline-primary me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button class="btn btn-action btn-outline-danger" onclick="deleteFood(@item.FoodID)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="addFoodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 bg-dark text-white p-4">
                <h5 class="modal-title fw-bold">Create New Food Entry</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small">Food Name</label>
                    <input type="text" id="foodName" class="form-control" placeholder="e.g., Grilled Chicken Salad">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary small">Calories (kcal)</label>
                        <input type="number" id="calories" class="form-control" placeholder="0">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary small">Category</label>
                        <select id="category" class="form-select">
                            <option value="Breakfast">Breakfast</option>
                            <option value="Lunch">Lunch</option>
                            <option value="Dinner">Dinner</option>
                            <option value="Snack">Snack/Dessert</option>
                        </select>
                    </div>
                </div>
                <div class="mb-0">
                    <label class="form-label fw-bold text-secondary small">Image URL</label>
                    <input type="text" id="imageUrl" class="form-control" placeholder="https://image-link.com/photo.jpg">
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-dark px-4 rounded-3" onclick="submitAddFood()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Submit New Food
        function submitAddFood() {
            var data = {
                FoodName: $('#foodName').val(),
                Calories: $('#calories').val(),
                ImageURL: $('#imageUrl').val(),
                Category: $('#category').val()
            };

            if (!data.FoodName || !data.Calories) {
                alert("Please provide both Food Name and Calories!");
                return;
            }

            $.post('/Admin/AddInternalFood', data, function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert("Error: " + res.message);
                }
            });
        }

        // Delete Food with Animation
        function deleteFood(id) {
            if (confirm("Are you sure you want to delete this item? This action cannot be undone.")) {
                $.post('/Admin/DeleteFood', { id: id }, function (res) {
                    if (res.success) {
                        $(`#row-${id}`).fadeOut(400, function () { $(this).remove(); });
                    } else {
                        alert(res.message);
                    }
                });
            }
        }

        // Toggle Visibility
        function toggleFoodVisibility(id) {
            $.post('/Admin/ToggleFoodVisibility', { id: id }, function (res) {
                if (!res.success) {
                    alert("Unable to update status!");
                    var cb = $(`#switch-${id}`);
                    cb.prop('checked', !cb.prop('checked'));
                }
            });
        }
    </script>
}